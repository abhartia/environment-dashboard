  "publisher_checks": [
    {"detail": "ours 250.0 vs stated 250 (tolerance ±0.5, difference 0)", "entity": "WLD", "period": "2010", "quote": "For the present day, CoastalDEM estimates a global total of 110 M people on land below the current high tide line and 250 M on land below annual flood levels,", "source_id": "kulp-strauss-2019", "stated": "250", "status": "pass", "url": "https://www.nature.com/articles/s41467-019-12808-z.pdf", "vintage": "Nature Communications 10: 4844 (2019), corrected 12 December 2019"},
    {"detail": "ours 360.0 vs stated 360 (tolerance ±0.5, difference 0)", "entity": "WLD", "period": "2100", "quote": "A total of 360 (310–420) million people are on land threatened by annual flood events in 2100, or an extra 110 (60–170) million beyond the contemporary baseline. This case reflects greenhouse gas emissions cuts roughly consistent with warming of 2 °C (emissions scenario RCP 4.5) and assumes a mostly stable Antarctic (sea-level model K14).", "source_id": "kulp-strauss-2019", "stated": "360", "status": "pass", "url": "https://www.nature.com/articles/s41467-019-12808-z.pdf", "vintage": "Nature Communications 10: 4844 (2019), corrected 12 December 2019"},
    {"detail": "ours 300.0 vs stated 300 (tolerance ±0.5, difference 0)", "entity": "WLD", "period": "2050", "quote": "In the case of Antarctic instability, a total of 300 (270–340) million people today live on land indicated as vulnerable to an annual flood event by mid-century, rising to as many as 480 (380–630) million by 2100.", "source_id": "kulp-strauss-2019", "stated": "300", "status": "pass", "url": "https://www.nature.com/articles/s41467-019-12808-z.pdf", "vintage": "Nature Communications 10: 4844 (2019), corrected 12 December 2019"},
