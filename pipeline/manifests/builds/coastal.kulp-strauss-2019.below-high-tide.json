    {"detail": "ours 110.0 vs stated 110 (tolerance ±0.5, difference 0)", "entity": "WLD", "period": "2010", "quote": "For the present day, CoastalDEM estimates a global total of 110 M people on land below the current high tide line and 250 M on land below annual flood levels,", "source_id": "kulp-strauss-2019", "stated": "110", "status": "pass", "url": "https://www.nature.com/articles/s41467-019-12808-z.pdf", "vintage": "Nature Communications 10: 4844 (2019), corrected 12 December 2019"},
    {"detail": "ours 150.0 vs stated 150 (tolerance ±0.5, difference 0)", "entity": "WLD", "period": "2050", "quote": "For one moderate future scenario, sea levels projected by 2050 are high enough to threaten land currently home to a total of 150 (140–170) million people to a future permanently below the high tide line,", "source_id": "kulp-strauss-2019", "stated": "150", "status": "pass", "url": "https://www.nature.com/articles/s41467-019-12808-z.pdf", "vintage": "Nature Communications 10: 4844 (2019), corrected 12 December 2019"},
